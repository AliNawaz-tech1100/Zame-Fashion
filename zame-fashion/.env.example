# ─── Sanity CMS ─────────────────────────────────────────────────────
# Project: Zame Fashion (95981i5a) · Dataset: production
NEXT_PUBLIC_SANITY_PROJECT_ID=95981i5a
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-11-01

# Server-only Sanity tokens (NEVER prefix these with NEXT_PUBLIC_).
# Create at: https://www.sanity.io/manage → project 95981i5a → API → Tokens
# - SANITY_API_READ_TOKEN: read access to the `production` dataset (storefront + live price checks)
# - SANITY_API_WRITE_TOKEN: read/write across `production` (stock) and `orders` (order documents)
# Never commit real tokens — this file is a template only.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Private dataset that stores order documents (contains customer PII).
SANITY_ORDERS_DATASET=orders

# ─── Order notification email (plain SMTP — no third-party SaaS) ────
# Any SMTP mailbox works: your hosting/cPanel email, Gmail (App Password),
# Zoho, etc. Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
# ORDER_NOTIFICATION_EMAIL: where new-order alerts are sent (your inbox)
# ORDER_NOTIFICATION_FROM: optional custom From address (defaults to SMTP_USER)
# Leave these empty to disable email alerts — orders still save normally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_FROM=

# ─── Admin dashboard (/admin) ───────────────────────────────────────
# Use a long random password. ADMIN_SESSION_SECRET: 32+ random characters
# (generate with: openssl rand -hex 32)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ─── Webhook revalidation (optional but recommended) ────────────────
# Sent as the `x-revalidate-secret` header to /api/revalidate by a Sanity webhook
REVALIDATE_SECRET=

# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
